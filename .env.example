# ---------------------------------------------------------------------------
# Zowall. Copy to .env.local and fill in. Never commit the filled copy.
# Nothing here has a working default: a build running on a fake key wastes
# more time than a loud failure.
# ---------------------------------------------------------------------------

# --- Whitechain (the money) ------------------------------------------------
EVM_CHAIN_ID=1874
EVM_RPC_URL=https://rpc.testnet.whitechain.io

# Real Whitechain Sepolia USDT, 6 decimals. A self-minted token does not count
# for the Whitechain tracks.
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# Filled in after `forge script script/DeployGate.s.sol`.
GATE_ADDRESS=

# Deployer / buyer treasury key. Needs WBT for gas from the faucet.
PRIVATE_KEY=

# --- The attestor (the humans) ---------------------------------------------
# Backend key that signs EIP-712 role attestations after a World proof
# verifies. Its address is the `attestor` constructor argument. Server only -
# if this reaches a browser, anyone can mint a verified human.
ATTESTOR_PRIVATE_KEY=
ATTESTOR_ADDRESS=

# --- World ID --------------------------------------------------------------
# From developer.world.org. The app must be in `external` mode, not
# `mini-app` - that is fixed at create time and cannot be changed later.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ACTION=zowall-enroll
# signing_key.private_key from the Portal. Shown exactly once.
WORLD_RP_SIGNING_KEY=
# `staging` for the simulator, `production` for real devices.
WORLD_ENVIRONMENT=staging
# `session` (preferred, repeatable) or `per-role` (fallback, one proof per
# human per role for the whole event).
WORLD_FRESHNESS_MODE=session

# --- Hedera (the journal) --------------------------------------------------
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# From `node packages/journal/src/cli.ts create-topic`. Goes in the README too.
HEDERA_TOPIC_ID=
# Submit key for the private topic. Only this service may append.
HEDERA_SUBMIT_KEY=

# --- Hedera x402 (the metered service) -------------------------------------
# Which facilitator is live this weekend is a booth question: Official x402,
# Ax402, Blocky402, or one we run.
FACILITATOR_URL=
X402_NETWORK=hedera-testnet
# Hedera account that receives the payment.
X402_PAY_TO=
# Testnet USDC token id. Two values are in circulation in the docs
# (0.0.429274 and 0.0.5449) - confirm the live one before wiring it.
X402_ASSET=
# Price per match check, in the asset's smallest unit.
X402_PRICE=1000
