# ---------------------------------------------------------------------------
# Zowall. Copy to .env.local and fill in. Never commit the filled copy.
# Nothing here has a working default: a build running on a fake key wastes
# more time than a loud failure.
# ---------------------------------------------------------------------------

# --- Whitechain (the money) ------------------------------------------------
EVM_CHAIN_ID=1874
EVM_RPC_URL=https://rpc.testnet.whitechain.io

# Real Whitechain Sepolia USDT, 6 decimals. A self-minted token does not count
# for the Whitechain tracks.
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# Filled in after `forge script script/DeployGate.s.sol`.
GATE_ADDRESS=
# First block of the deployed gate. Bounds log scans, which the public RPC caps
# at 10,000 blocks per request.
GATE_DEPLOY_BLOCK=
GATE_ADDRESS=

# Deployer / buyer treasury key. Needs WBT for gas from the faucet.
PRIVATE_KEY=

# --- The attestor (the humans) ---------------------------------------------
# Backend key that signs EIP-712 role attestations after a World proof
# verifies. Its address is the `attestor` constructor argument. Server only -
# if this reaches a browser, anyone can mint a verified human.
# The attestor QUORUM. Each is an independent service that verifies the World ID
# proof itself; the gate accepts an attestation only when ATTESTOR_THRESHOLD of
# them signed it. Comma-separated. In production each key lives in a different
# service run by a different party. ATTESTOR_ADDRESSES are the matching public
# addresses, passed to the contract constructor.
ATTESTOR_PRIVATE_KEYS=
ATTESTOR_ADDRESSES=
ATTESTOR_THRESHOLD=2

# --- World ID --------------------------------------------------------------
# From developer.world.org. The app must be in `external` mode, not
# `mini-app` - that is fixed at create time and cannot be changed later.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ACTION=zowall-enroll
# signing_key.private_key from the Portal. Shown exactly once.
WORLD_RP_SIGNING_KEY=
# `staging` for the simulator, `production` for real devices.
WORLD_ENVIRONMENT=staging
# `session` (preferred, repeatable) or `per-role` (fallback, one proof per
# human per role for the whole event).
WORLD_FRESHNESS_MODE=session

# --- Hedera (the journal) --------------------------------------------------
# From portal.hedera.com. The portal issues ECDSA keys in DER form, starting
# with 303 - paste it exactly as shown. Either curve is accepted.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# From `node packages/journal/src/cli.ts create-topic`. Goes in the README too.
HEDERA_TOPIC_ID=
# Submit key for the private topic. Only this service may append.
HEDERA_SUBMIT_KEY=

# --- Hedera x402 (the metered service) -------------------------------------
# Hosted facilitator from hedera-dev/x402-hedera. Several facilitators exist and
# a self-hosted one works the same way, so this is configuration.
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera-testnet
# Hedera account that receives the payment.
X402_PAY_TO=
# Hedera testnet USDC, per the official hedera-dev/x402-hedera repo.
# The PAYING account must associate this token first (TokenAssociateTransaction)
# or the call fails with TOKEN_NOT_ASSOCIATED.
X402_ASSET=0.0.429274
# Price per match check, in the asset's smallest unit.
X402_PRICE=1000

# --- demo executor ---------------------------------------------------------
# Lets the walkthrough and attack console submit real transactions from the
# server, signed by PRIVATE_KEY and VENDOR_PRIVATE_KEY. Leave unset on any
# deployment that should be read-only.
DEMO_ENABLED=false
# Signs vendor invoices for the walkthrough. Never holds funds except what a
# walkthrough pays it, which the reset step returns to the vault.
VENDOR_PRIVATE_KEY=

# x402 guardian-protected payer (create with packages/x402/scripts/guardian-setup.ts).
# The payer account's key is a threshold structure on the Hedera ledger: the agent
# AND X402_GUARDIAN_THRESHOLD of the guardians must sign a payment, so skipping the
# middleware cannot move money. These are secrets; the script writes them for you.
X402_PAYER_ACCOUNT=
X402_PAY_TO=
X402_AGENT_KEY=
X402_GUARDIAN_KEYS=
X402_GUARDIAN_THRESHOLD=2
